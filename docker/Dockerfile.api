FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install runtime dependencies. requirements.txt is compiled from
# requirements.in (regeneration command in either file's header), so every
# package — transitive deps included — is pinned to an exact version and
# sha256. --require-hashes makes pip enforce those pins and --only-binary
# keeps sdist setup scripts from executing at build time. Do not swallow
# failures here.
COPY requirements.txt .
RUN pip install --no-cache-dir --require-hashes --only-binary :all: -r requirements.txt

# We will mount the working directory via docker-compose, 
# but copying the code makes the image self-contained if needed.
COPY . .

# Environment variables
ENV PYTHONUNBUFFERED=1

EXPOSE 55555

# /api/health is exempt from token auth, so this works whether or not
# SMG_API_TOKEN is set. start-period covers init_db plus any legacy secret
# re-encryption on first boot.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${SMG_API_PORT:-55555}/api/health/" || exit 1

# Bind to loopback by default — the API holds the Docker socket and must not be
# reachable from the LAN. docker-compose overrides this to 0.0.0.0 because a
# published port cannot reach a loopback-bound listener; exposure is then
# restricted by the 127.0.0.1 port mapping instead. Shell form so the env var
# expands.
CMD gunicorn --bind ${SMG_API_BIND:-127.0.0.1:55555} --workers 1 --threads 8 --timeout 180 main:app

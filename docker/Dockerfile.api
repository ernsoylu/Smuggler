FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install runtime dependencies. requirements.txt is the single source of truth
# for the API image and already pins flask, flask-cors, requests, docker,
# python-dotenv and gunicorn — do not swallow failures here.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# We will mount the working directory via docker-compose, 
# but copying the code makes the image self-contained if needed.
COPY . .

# Environment variables
ENV PYTHONUNBUFFERED=1

EXPOSE 55555

# Bind to loopback by default — the API holds the Docker socket and must not be
# reachable from the LAN. Override SMG_API_BIND only behind an authenticated
# reverse proxy. Shell form so the env var expands.
CMD gunicorn --bind ${SMG_API_BIND:-127.0.0.1:55555} --workers 1 --threads 8 --timeout 180 main:app

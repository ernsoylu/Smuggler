# Stage 1: Build the Vite application
#
# Digest only, no tag. A tag alongside a digest is redundant — the digest is
# what actually resolves — and Sonar (S8431) flags carrying both. The tag is
# kept in this comment so the update channel stays obvious: node:20-alpine.
FROM node@sha256:0473e7dc433a1310f436edee02aa79737ec78a4b345433ab0963d4a256f9ad85 AS builder

WORKDIR /app
COPY web/package*.json ./
# --ignore-scripts: no dependency lifecycle script runs during install. The CI
# workflows were hardened this way already; the image build had been missed,
# which mattered more, since this is what actually ships.
RUN npm ci --ignore-scripts

COPY web/ ./
RUN npm run build

# Stage 2: Serve the built app with Nginx.
#
# nginx-unprivileged rather than stock nginx: it runs as uid 101 and listens on
# 8080, so the container facing the browser holds no root at all. Stock nginx
# starts as root to bind :80 and only drops its worker processes.
# Digest only, per the note above. Tag: nginxinc/nginx-unprivileged:alpine.
FROM nginxinc/nginx-unprivileged@sha256:197f252f060ed357f2ab98d4256762d7d107c76f18ad8f0b9d5178854611566d

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Install as a template so the nginx entrypoint runs envsubst on it at start
# (renders SMG_API_TOKEN into the proxy config). Only SMG_* vars are substituted
# so nginx runtime vars ($uri, $host, …) survive. The rendered file lands at
# /etc/nginx/conf.d/default.conf, replacing the stock server block.
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER=^SMG_

# nginx listens on :8080 inside the container (unprivileged); docker-compose
# publishes it to 127.0.0.1:8887 on the host.
EXPOSE 8080

# Hits the static root rather than /api/, so the UI's health does not depend on
# the API being up.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1

# Redundant at runtime — the base image already defaults to uid 101 — but
# stated explicitly so it is visible to static analysis (Sonar S6471) and to
# anyone reading the file, rather than being an implicit property of the base.
USER 101

CMD ["nginx", "-g", "daemon off;"]

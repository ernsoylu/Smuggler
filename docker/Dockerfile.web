# Stage 1: Build the Vite application
FROM node:20-alpine AS builder

WORKDIR /app
COPY web/package*.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

# Stage 2: Serve the built app with Nginx
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Install as a template so the nginx entrypoint runs envsubst on it at start
# (renders SMG_API_TOKEN into the proxy config). Only SMG_* vars are substituted
# so nginx runtime vars ($uri, $host, …) survive. The rendered file lands at
# /etc/nginx/conf.d/default.conf, replacing the stock server block.
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER=^SMG_

# UI listens on 127.0.0.1:8887 (see the template) — runs with host networking.
EXPOSE 8887
CMD ["nginx", "-g", "daemon off;"]

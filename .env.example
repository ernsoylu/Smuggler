# Smuggler environment configuration.
#
# Copy to .env and fill in, or just run ./setup.sh — it generates .env with
# fresh secrets and chmod 600s it. Never commit the real .env.

# ─── Secrets ─────────────────────────────────────────────────────────────────

# Encrypts stored secrets at rest: OpenVPN passwords AND VPN config bodies
# (WireGuard private keys, inline OpenVPN keys). Generate with:
#   openssl rand -base64 32
# Keep it stable — changing or losing it makes existing encrypted configs
# unrecoverable. With no key set, uploading a VPN config is REFUSED (503).
SMG_SECRET_KEY=

# Per-deployment salt for the scrypt key derivation. Not secret, but it must
# stay stable — treat it like the key and back it up alongside .env. Leave unset
# on an existing deployment: setup.sh writes one only for fresh installs, and
# omitting it keeps the built-in default salt so existing rows stay readable.
SMG_SECRET_SALT=

# Required on every /api/* request as the X-Smuggler-Token header. The web UI
# injects it via nginx; the `smg` CLI reads it from the environment.
# The API holds the Docker socket, so this is enabled by default — comment it
# out only if a local client cannot send the header.
SMG_API_TOKEN=

# Escape hatch: store secrets unencrypted when SMG_SECRET_KEY is unset.
# Off by default and not recommended; exists for local experimentation.
# SMG_ALLOW_PLAINTEXT_SECRETS=0

# ─── Network ─────────────────────────────────────────────────────────────────

# Gunicorn bind address. Loopback-only by default — the API is host-root
# equivalent via the Docker socket. Widen this only behind an authenticated,
# TLS-terminating reverse proxy.
# SMG_API_BIND=127.0.0.1:55555

# Port the image's HEALTHCHECK probes. Only needed if you move the API off
# 55555; SMG_API_BIND is what actually decides where it listens.
# SMG_API_PORT=55555

# Extra browser origins allowed by CORS and the CSRF guard (comma-separated,
# or "*"). Defaults cover localhost:5173 (Vite dev) and localhost:8887 (nginx).
# Set this to your real UI origin if you front the UI with a proxy, otherwise
# the CSRF guard rejects your own UI's writes with 403.
# SMG_CORS_ORIGINS=https://smuggler.example.com

# ─── Mules ───────────────────────────────────────────────────────────────────

# How the API addresses each mule's aria2 RPC. docker-compose sets this to
# "container", meaning the API dials the mule by container name over the
# internal smuggler-rpc network. Anything else (or unset) uses the mule's
# published loopback port, which is what the `smg` CLI and ./start.sh debug
# need since they run on the host, not in a container.
#
# NOTE: SMG_API_TOKEN is mandatory when this is "container" — mules share that
# network with the API and could otherwise drive Docker unauthenticated.
# SMG_MULE_RPC_HOST=container

# Name of that internal network. Only change it if you rename the network in
# docker-compose.yml.
# SMG_RPC_NETWORK=smuggler-rpc

# uid/gid aria2 drops to before downloading, so files land owned by you rather
# than root. Defaults to the owner of the downloads directory — set these only
# if that is not the user you want.
# SMG_PUID=1000
# SMG_PGID=1000

# Resource ceilings per mule, so one runaway or hostile download cannot exhaust
# host memory or the PID table.
# SMG_MULE_MEM_LIMIT=1g
# SMG_MULE_PIDS_LIMIT=512

# ─── Paths ───────────────────────────────────────────────────────────────────

# Host-side project root. Used to build paths that get mounted into mule
# containers (data/tmp for VPN configs, downloads). docker-compose sets this
# to $PWD; override only if the compose file and host layout differ.
# SMG_HOST_ROOT=/absolute/path/to/Smuggler

# SQLite database location.
# SMG_DB_PATH=/absolute/path/to/Smuggler/data/smuggler.db

# ─── Watchdog ────────────────────────────────────────────────────────────────

# Background VPN watchdog: sweeps every mule, and evacuates one whose tunnel
# fails repeatedly. On by default. Turning it off leaves mules unmonitored —
# the test suite disables it so a sweep cannot issue HTTP mid-test.
# SMG_WATCHDOG_ENABLED=true

# ─── Observer / events ───────────────────────────────────────────────────────

# Systemwide observer: a background thread that records every mule state
# transition, harvests container stdout for secret-shaped content, and keeps
# an audit trail in the events table (see /api/events). On by default.
# SMG_OBSERVER_ENABLED=true

# Seconds between observer sweeps.
# SMG_OBSERVER_INTERVAL=30

# Record an aggregate snapshot event every N sweeps (0 disables snapshots).
# SMG_OBSERVER_SNAPSHOT_SWEEPS=10

# Event retention: rows older than this many days are pruned (0 keeps forever),
# and the table is capped to this many rows (oldest dropped first).
# SMG_EVENTS_RETENTION_DAYS=14
# SMG_EVENTS_MAX_ROWS=50000

# ─── Logging / debug ─────────────────────────────────────────────────────────

SMG_LOGGING=true
SMG_LOG_LEVEL=INFO

# Log files older than this many days are deleted at process start (0 keeps
# them forever). Files also rotate at 10 MB with 3 backups.
# SMG_LOG_RETENTION_DAYS=14

# Flask debug mode for ./start.sh debug. Never enable in production.
# SMG_DEBUG=0

# Smuggler environment configuration.
#
# Copy to .env and fill in, or just run ./setup.sh — it generates .env with
# fresh secrets and chmod 600s it. Never commit the real .env.

# ─── Secrets ─────────────────────────────────────────────────────────────────

# Encrypts stored secrets at rest: OpenVPN passwords AND VPN config bodies
# (WireGuard private keys, inline OpenVPN keys). Generate with:
#   openssl rand -base64 32
# Keep it stable — changing or losing it makes existing encrypted configs
# unrecoverable. With no key set, uploading a VPN config is REFUSED (503).
SMG_SECRET_KEY=

# Per-deployment salt for the scrypt key derivation. Not secret, but it must
# stay stable — treat it like the key and back it up alongside .env. Leave unset
# on an existing deployment: setup.sh writes one only for fresh installs, and
# omitting it keeps the built-in default salt so existing rows stay readable.
SMG_SECRET_SALT=

# Required on every /api/* request as the X-Smuggler-Token header. The web UI
# injects it via nginx; the desktop client and CLI read it from the environment.
# The API holds the Docker socket, so this is enabled by default — comment it
# out only if a local client cannot send the header.
SMG_API_TOKEN=

# Escape hatch: store secrets unencrypted when SMG_SECRET_KEY is unset.
# Off by default and not recommended; exists for local experimentation.
# SMG_ALLOW_PLAINTEXT_SECRETS=0

# ─── Network ─────────────────────────────────────────────────────────────────

# Gunicorn bind address. Loopback-only by default — the API is host-root
# equivalent via the Docker socket. Widen this only behind an authenticated,
# TLS-terminating reverse proxy.
# SMG_API_BIND=127.0.0.1:55555

# Extra browser origins allowed by CORS and the CSRF guard (comma-separated,
# or "*"). Defaults cover localhost:5173 (Vite dev) and localhost:8887 (nginx).
# Set this to your real UI origin if you front the UI with a proxy, otherwise
# the CSRF guard rejects your own UI's writes with 403.
# SMG_CORS_ORIGINS=https://smuggler.example.com

# Base URL the CLI and desktop client use to reach the API.
# SMG_API_URL=http://127.0.0.1:55555

# ─── Paths ───────────────────────────────────────────────────────────────────

# Host-side project root. Used to build paths that get mounted into mule
# containers (data/tmp for VPN configs, downloads). docker-compose sets this
# to $PWD; override only if the compose file and host layout differ.
# SMG_HOST_ROOT=/absolute/path/to/Smuggler

# SQLite database location.
# SMG_DB_PATH=/absolute/path/to/Smuggler/data/smuggler.db

# ─── Logging / debug ─────────────────────────────────────────────────────────

SMG_LOGGING=true
SMG_LOG_LEVEL=INFO

# Flask debug mode for ./start.sh debug. Never enable in production.
# SMG_DEBUG=0
